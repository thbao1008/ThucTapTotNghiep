{
  "name": "aesp-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "node backend/services/start-all-services.js --with-frontend",
    "dev:check": "node backend/services/start-all-services.js --with-frontend --check",
    "dev:fe": "node frontend/start-frontend.js",
    "dev:be:micro": "node backend/services/start-all-services.js",
    "dev:micro": "npm run dev:all",
    "start": "npm run dev:all",
    "build": "npm run build:fe",
    "build:fe": "npm --prefix frontend run build",
    "setup": "node scripts/setup.mjs --install --speech --models",
    "setup:plan": "node scripts/setup.mjs --dry-run",
    "doctor": "node scripts/doctor.mjs",
    "db:init": "node scripts/database.mjs init",
    "init:db": "node scripts/database.mjs init",
    "db:check": "node scripts/database.mjs check",
    "admin:create": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "form-data": "^4.0.4",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
