# Copy to backend/.env.local. SETUP_AESP.cmd creates it only when absent.
# Never put these settings in frontend code.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=aesp
DB_USER=postgres
DB_PASSWORD=
JWT_SECRET=__GENERATE__
AESP_LEARNER_SERVICE_TOKEN=__GENERATE__
AESP_MENTOR_SERVICE_TOKEN=__GENERATE__
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=45000
GROQ_MAX_OUTPUT_TOKENS=4096
# Optional Vietnamese female speech; without this key the app uses browser speech.
FPT_AI_API_KEY=
# Leave unset to use backend/.venv-whisperx automatically.
# WHISPERX_PYTHON_EXECUTABLE=
AESP_OPEN_BROWSER=true

# Optional absolute FFmpeg bin directory; otherwise PATH/project portable folder is used.
# FFMPEG_BIN=C:/Tools/ffmpeg/bin
